{
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next",
      "config": {
        "installCommand": "npm install --no-optional --ignore-scripts",
        "buildCommand": "npm run prebuild && npm run build"
      }
    }
  ],
  "build": {
    "env": {
      "NODE_VERSION": "18.x",
      "SKIP_CANVAS_INSTALL": "true",
      "CANVAS_SKIP_INSTALL": "true"
    }
  },
  "env": {
    "NODE_OPTIONS": "--max-old-space-size=4096"
  }
}
